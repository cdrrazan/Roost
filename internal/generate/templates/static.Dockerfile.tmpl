{{- if .StaticBuild}}
FROM node:{{.NodeTag}} AS builder
WORKDIR /app
COPY package.json package-lock.jso[n] ./
RUN npm ci || npm install
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=builder /app/dist /srv
{{- else}}
FROM caddy:2-alpine
COPY . /srv
{{- end}}
EXPOSE 80
CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":80"]
