# Generated by roost — do not edit; this file is regenerated on every run.
# Automatic HTTPS stays off: Cloudflare terminates TLS at the edge, and
# letting Caddy also try would fight the tunnel and burn Let's Encrypt
# rate limits.
{
	auto_https off
}
{{range .}}
http://{{.FQDN}} {
	# Cloudflare terminates TLS at the edge; the request reaches the app over
	# http internally. Tell the app the public scheme is https so it builds
	# https URLs and its Origin/CSRF check matches the browser (otherwise Rails
	# rejects the https Origin against an http base_url with a 422).
	reverse_proxy {{.Name}}:{{.Port}} {
		header_up X-Forwarded-Proto https
	}
}
{{end}}
