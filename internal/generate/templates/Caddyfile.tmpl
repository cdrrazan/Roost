# Generated by roost — do not edit; this file is regenerated on every run.
# Automatic HTTPS stays off: Cloudflare terminates TLS at the edge, and
# letting Caddy also try would fight the tunnel and burn Let's Encrypt
# rate limits.
{
	auto_https off
}

# Branded page served when an app's container is down or unhealthy: without
# this, Caddy hands back a bare "502 Bad Gateway". The tunnel is still up, so
# Caddy is reachable and can answer for the dead upstream. (A wholly-down
# tunnel — Cloudflare 1033 — never reaches Caddy; the edge Worker covers that.)
(roost_maintenance) {
	handle_errors {
		root * /etc/caddy
		rewrite * /error.html
		file_server
		header Content-Type "text/html; charset=utf-8"
	}
}
{{range .Apps}}
http://{{.FQDN}} {
	# Cloudflare terminates TLS at the edge; the request reaches the app over
	# http internally. Tell the app the public scheme is https so it builds
	# https URLs and its Origin/CSRF check matches the browser (otherwise Rails
	# rejects the https Origin against an http base_url with a 422).
	reverse_proxy {{.Name}}:{{.Port}} {
		header_up X-Forwarded-Proto https
	}
	import roost_maintenance
}
{{end}}
{{- if .ControlHost}}
http://{{.ControlHost}} {
	# roost web control panel. It runs on the host (outside the stack, so
	# "stop" can't kill its own control plane); Caddy reaches it via the
	# host gateway declared in compose.yml.
	reverse_proxy host.docker.internal:4600 {
		header_up X-Forwarded-Proto https
	}
}
{{- end}}
