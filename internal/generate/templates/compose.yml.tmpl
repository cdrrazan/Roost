# Generated by roost — do not edit; this file is regenerated on every run.
name: roost

services:
{{- range .Apps}}
  {{.Name}}:
    build:
      context: {{.Path}}
      dockerfile: {{.Dockerfile}}
    restart: unless-stopped
    mem_limit: {{.Memory}}
{{- if .Command}}
    command: {{.Command}}
{{- end}}
{{- if .Env}}
    environment:
{{- range .Env}}
      {{.Key}}: "{{.Value}}"
{{- end}}
{{- end}}
{{- if .Profile}}
    profiles:
      - {{.Profile}}
{{- end}}
{{- if .MountSource}}
    volumes:
      - {{.Path}}:/app:ro
{{- end}}
{{- if or .Database .Redis}}
    depends_on:
{{- if .Database}}
      - {{.Database}}
{{- end}}
{{- if .Redis}}
      - redis
{{- end}}
{{- end}}
    networks:
      - roost
{{end}}
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    volumes:
      - {{.BuildDir}}/Caddyfile:/etc/caddy/Caddyfile:ro
    networks:
      - roost

  cloudflared:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: tunnel run --token ${ROOST_TUNNEL_TOKEN}
    networks:
      - roost
{{- if .NeedsMySQL}}

  # Database ports are never published to the host: apps reach mysql by
  # service name on the internal network. Publishing would reintroduce
  # port conflicts and bypass the host firewall entirely.
  mysql:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "roost"
    volumes:
      - {{.BuildDir}}/mysql-init.sql:/docker-entrypoint-initdb.d/roost-init.sql:ro
      - roost-mysql-data:/var/lib/mysql
    networks:
      - roost
{{- end}}
{{- if .NeedsPostgres}}

  # Database ports are never published to the host: apps reach postgres by
  # service name on the internal network. Publishing would reintroduce
  # port conflicts and bypass the host firewall entirely.
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: "roost"
      POSTGRES_PASSWORD: "roost"
    volumes:
      - {{.BuildDir}}/postgres-init.sql:/docker-entrypoint-initdb.d/roost-init.sql:ro
      - roost-postgres-data:/var/lib/postgresql/data
    networks:
      - roost
{{- end}}
{{- if .NeedsRedis}}

  # Redis backs Action Cable, the Rails cache, and the Sidekiq broker.
  # Not published to the host — apps reach it by service name.
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    volumes:
      - roost-redis-data:/data
    networks:
      - roost
{{- end}}

networks:
  roost: {}
{{- if or .NeedsMySQL .NeedsPostgres .NeedsRedis}}

volumes:
{{- if .NeedsMySQL}}
  roost-mysql-data: {}
{{- end}}
{{- if .NeedsPostgres}}
  roost-postgres-data: {}
{{- end}}
{{- if .NeedsRedis}}
  roost-redis-data: {}
{{- end}}
{{- end}}
